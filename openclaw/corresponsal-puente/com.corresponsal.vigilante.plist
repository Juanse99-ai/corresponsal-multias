<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Revisa cada 5 minutos que OpenClaw esté encendido (vigilante.sh). Se copia
     a ~/Library/LaunchAgents/ cambiando RUTA por la carpeta del plugin. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.corresponsal.vigilante</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>RUTA/vigilante.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
</dict>
</plist>
